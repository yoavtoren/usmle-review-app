{
  "appId": "com.yoavtoren.usmlereview",
  "appName": "Yoav's USMLE tracker",
  "webDir": "dist-ios",
  "ios": {
    "scheme": "USMLE Tracker",
    "contentInset": "always",
    "backgroundColor": "#F5F2EA"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 700,
      "launchAutoHide": true,
      "backgroundColor": "#F5F2EA",
      "showSpinner": false,
      "iosSpinnerStyle": "small"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F5F2EA"
    }
  }
}
