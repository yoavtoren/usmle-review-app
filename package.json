{
  "name": "usmle-review-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal offline USMLE Step 1 review deck (questions you missed), rendered as interactive review cards.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && rm -f dist/firstaid/*.pdf && npx gh-pages -d dist",
    "build:ios": "CAP_BUILD=1 vite build",
    "sync:ios": "npm run build:ios && npx cap sync ios",
    "open:ios": "npx cap open ios",
    "lint": "eslint src --ext .js,.jsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@emailjs/browser": "^4.4.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
